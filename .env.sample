# Vanosilla Server Umgebungsvariablen
# Kopieren Sie diese Datei nach .env für Konfiguration

#############################################
# PORT KONFIGURATION (gRPC Endpoints)
#############################################
# BazaarServer - Trading/Wirtschaft System
BazaarServer_Port=50051

# DatabaseServer - Datenbank-Persistenz
DatabaseServer_Port=50052

# LoginServer - Authentifizierung
LoginServer_Port=50055

# FamilyServer - Familiensystem
FamilyServer_Port=50056

# DiscordNotifier - Discord Integration
DiscordNotifier_Port=50057

#############################################
# DATENBANK KONNEKTIONSSTRINGE
#############################################
# PostgreSQL (GameData + Bazaar)
PostgreSQL_Connection="Host=localhost;Port=5432;Database=bazaar"

# MongoDB (Logs, Family-Storage)
MongoDB_Connection="mongodb://localhost:27017/vanosilla-game-data"

# Redis (Caching Layer)
Redis_Connection="localhost:6379"

#############################################
# MQTT BROKER FÜR EVENTS
#############################################
MQTT_Broker=localhost:1883
MQTT_Topic="vanosilla/events"

#############################################
# SERVER SPEZIFISCHE KONFIGURATION
#############################################
BazaarServer_EnableAutoTrade=TRUE
DatabaseServer_AutoMigrate=TRUE
LoginServer_SupportOffline=TRUE
