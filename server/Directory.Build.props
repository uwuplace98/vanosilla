<!-- Directory.Build.props für Vanosilla .NET Server-Projekte -->
<!-- WICHTIG: Dieses Template wird von allen 140+ Projekten in server/ überschrieben! -->

<Project>
    <!-- Generische Settings für alle Projekte -->
    <PropertyGroup>
        <!-- Zielframework (standardmäßig net8.0, übernehmbar) -->
        <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>

        <!-- Ausgabeverzeichnis (relativ zur Projektroot) -->
        <OutputPath>..\..\dist\$(MSBuildProjectName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!-- Langversion für C# 17/18 Features -->
        <LangVersion>latest</LangVersion>

        <!-- Enabler für experimental features -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

        <!-- MSBuild-Einstellungen für Performance und Konsistenz -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningLevel>default</WarningLevel>

        <!-- NuGet Paket Restore -->
        <NuGetToolSettingsPath>tools\nuget.bat</NuGetToolSettingsPath>
    </PropertyGroup>

    <!-- Build-Einstellungen für Web-Projekte (ASP.NET Core gRPC Server) -->
    <PropertyGroup Condition="'$(UseWebTools)' == 'true'">
        <IsPackable>false</IsPackable>
        <SelfContained>true</SelfContained>
        <DockerComposeFile>../_docker/docker-compose.windows.yml</DockerComposeFile>
        <DockerComposeAction>build</DockerComposeAction>
    </PropertyGroup>

    <!-- Paketversionen (global) -->
    <!-- Diese können überpritten werden durch projekt-specific Settings -->
    <ItemGroup>
        <!-- Grpc.Core Dependencies -->
        <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" PrivateAssets="all" />
        <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.1.1" PrivateAssets="all" />

        <!-- Entity Framework Core PostgreSQL -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
        <PackageReference Include="Z.EntityFramework.Extensions.EFCore" Version="8.102.2.5" />

        <!-- Caching & Logging -->
        <PackageReference Include="StackExchange.Redis" Version="2.6.122" />
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    </ItemGroup>

    <!-- Plugins-Abhängigkeiten (nur für _plugins-Projekte) -->
    <PropertyGroup Condition="'$(IsPluginProject)' == 'true'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    </PropertyGroup>
</Project>
